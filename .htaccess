# Video Portal — app-root .htaccess
#
# This file only matters for deployment (B): the host's docroot is the app root
# and cannot be moved to public/. It serves the app out of public/ while denying
# direct access to everything else.
#
# If your docroot IS public/, this file is never read and can be ignored.

# --- Deny the non-public tree outright -------------------------------------
<FilesMatch "^(config\.php|composer\.(json|lock)|phpunit\.xml(\.dist)?|\.env.*)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct hits on the application tree.
    RewriteRule ^(core|plugins|themes|storage|vendor|tests)/ - [F,L]

    # Serve real files that already live under public/.
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Everything else -> front controller.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^ public/index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
