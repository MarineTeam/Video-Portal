{
  "name": "marineteam/video-portal",
  "description": "Self-hosted video portal and media library. Installs on shared hosting via a web wizard.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-json": "*",
    "firebase/php-jwt": "^6.10",
    "guzzlehttp/guzzle": "^7.8",
    "phpmailer/phpmailer": "^6.9",
    "minishlink/web-push": "^9.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Portal\\": "core/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Portal\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2.0"
    }
  }
}
